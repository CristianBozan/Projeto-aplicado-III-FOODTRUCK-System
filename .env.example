# ─────────────────────────────────────────────────────────────
# Food Truck System v3.3 — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versione o arquivo .env — ele já está no .gitignore.
# ─────────────────────────────────────────────────────────────

# Ambiente (development | production)
# Em produção (Railway): defina como production
# Isso ativa a ocultação de mensagens de erro internas nas respostas HTTP
NODE_ENV=production

# ── Banco de Dados MySQL ──────────────────────────────────────
DB_NAME=sistema_pedidos
DB_USER=foodtruck_user
DB_PASS=troque_a_senha_do_banco
DB_HOST=localhost
DB_PORT=3306
DB_DIALECT=mysql

# Servidor
PORT=3000

# ── Segurança JWT ─────────────────────────────────────────────
# Use uma chave longa e aleatória (mín. 32 caracteres)
# Gere uma: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OBRIGATÓRIO — o servidor não sobe sem esta variável
JWT_SECRET=troque_para_uma_chave_secreta_longa_e_aleatoria
JWT_EXPIRES=8h

# ── Credenciais do Gerente ────────────────────────────────────
# Acesso gerencial completo (produtos, relatórios, backups)
# Se GERENTE_SENHA não estiver definida, o login de gerente fica desabilitado
GERENTE_LOGIN=admin
GERENTE_SENHA=troque_para_uma_senha_forte

# ── Token de proteção dos backups ────────────────────────────
# Protege os endpoints POST /backups, GET /backups/:id/restore etc.
# Use uma string aleatória e difícil de adivinhar
BACKUP_TOKEN=troque_para_um_token_secreto_forte

# ── CORS — origens permitidas ─────────────────────────────────
# Em desenvolvimento local: pode deixar * ou http://localhost:3000
# Em produção (Railway): use a URL pública do seu deploy para restringir
# Exemplo: https://projeto-aplicado-iii-foodtruck-system-production.up.railway.app
ALLOWED_ORIGINS=*

# ── Cloudinary (upload de imagens de produtos) ───────────────
# Crie uma conta gratuita em cloudinary.com e preencha as chaves
# Se não configurado, o upload de arquivo ficará desabilitado
# (o campo foto continua aceitando URLs textuais)
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret
